@model PrezentacioniSloj.ViewModels.AdminViewModel

<h2>Administratorska strana</h2>

<form asp-action="Index" method="get">

    <label>Prezime:</label>
    <input asp-for="PrezimePretraga" />

    <label>Status članarine:</label>
    <select asp-for="StatusClanarineFilter">
        <option value="">Sve</option>
        <option value="Aktivna">Aktivna</option>
        <option value="Neaktivna">Neaktivna</option>
    </select>

    <button type="submit">Pretraži</button>
    <a asp-action="Index" class="btn btn-secondary">
        Očisti filtere
    </a>

</form>

<tbody>

    @foreach (var korisnik in Model.Korisnici)
    {
        <tr>
            <td>@korisnik.Ime</td>
            <td>@korisnik.Prezime</td>
            <td>@korisnik.Email</td>
            <td>@korisnik.StatusClanarine</td>

            <td>
                <a asp-controller="Admin"
                   asp-action="ProfilKorisnika"
                   asp-route-korisnikId="@korisnik.KorisnikID">
                    Detalji
                </a>
            </td>
        </tr>
    }

</tbody>
</table>