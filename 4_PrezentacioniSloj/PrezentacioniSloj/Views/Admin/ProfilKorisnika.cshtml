@model PrezentacioniSloj.ViewModels.KorisnikProfilAdminViewModel

<div class="upravljanje-clanarinom">
    <div class="naslov">
        <h2>Profil korisnika</h2>
        <form asp-controller="Admin" asp-action="Index" method="get">
            <button class="dugme-prvo" type="submit">Nazad</button>
        </form>
    </div>
    
    

    @if (TempData["PorukaAdmin"] != null)
    {
        <div>
            @TempData["PorukaAdmin"]
        </div>
    }

    <div class="upravljanje-info">
        <p><b>Ime:</b> @Model.Ime</p>

        <p><b>Prezime:</b> @Model.Prezime</p>

        <p><b>Email:</b> @Model.Email</p>

        <p><b>Telefon:</b> @Model.BrojTelefona</p>

        <p><b>Pol:</b> @Model.Pol</p>

        <p><b>Datum rođenja:</b> @Model.DatumRodjenja</p>

        <hr />
        <div class="naslov">
            <h2>Članarina</h2>
        </div>
        

        <p><b>Status:</b> @Model.StatusClanarine</p>

        <p><b>Aktivacija:</b> @Model.DatumAktivacije</p>

        <p><b>Istek:</b> @Model.DatumIsteka</p>

        <p><b>Cena članarine:</b> @Model.Cena din</p>

        <p><b>Popust:</b> @Model.Popust %</p>

        <p><b>Zahtev za produženje:</b> @(Model.ZahtevZaProduzenje ? "Poslat" : "Nije poslat")</p>

        @if (Model.ZahtevZaProduzenje)
        {
            <form asp-action="PotvrdiUplatu" method="post">
                <input type="hidden" name="korisnikID" value="@Model.KorisnikID" />

                <button class="dugme-prvo evidencija" type="submit">Potvrdi uplatu</button>
            </form>

            <form asp-action="OdbijZahtev" method="post">
                <input type="hidden" name="korisnikID" value="@Model.KorisnikID" />

                <button class="dugme-trece evidencija" type="submit">Odbij zahtev</button>
            </form>
        }
    </div>
    
</div>

