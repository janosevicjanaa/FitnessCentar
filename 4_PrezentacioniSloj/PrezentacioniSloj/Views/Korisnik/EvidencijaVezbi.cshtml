@model PrezentacioniSloj.ViewModels.EvidencijaVezbiViewModel

<style>
	@@media print{
		.ne-stampaj{
			display: none;
		}
	}

</style>

<h2>EVIDENCIJA VEŽBI</h2>

<form asp-controller="Korisnik" asp-action="Index" method="get">
	<button type="submit">Nazad</button>
</form>

@{
	var datum = Model.Datum.ToString("dddd, d. MMMM, yyyy", new System.Globalization.CultureInfo("sr-Latn-RS"));
	datum = char.ToUpper(datum[0]) + datum.Substring(1);
}

<h3>@datum</h3>


<table>
	<thead>
		<tr>
			<th>Naziv vežbe</th>
			<th>Tip</th>
			<th>Br. Serija</th>
			<th>Br. Ponavljanja</th>
			<th>Težina</th>
			<th>Trajanje</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var vezba in Model.Vezbe)
		{

			<tr>
				<td>@vezba.NazivVezbe</td>
				<td>@vezba.NazivTipa</td>
				<td>@vezba.BrojSerija</td>
				<td>@vezba.BrojPonavljanja</td>
				<td>@vezba.Tezina</td>
				<td>@vezba.Trajanje</td>
			</tr>

		}
	</tbody>
</table>

<form asp-action="IzmeniEvidenciju" method="get">
	<input type="hidden" name="datum" value="@Model.Datum.ToString("yyyy-MM-dd")" />
	<button class="ne-stampaj" type="submit">Izmeni evidenciju</button>
</form>

<form asp-action="IzbrisiSve" method="post">
	<input type="hidden" name="datum" value="@Model.Datum" />
	<button class="ne-stampaj" type="submit">Izbriši evidenciju</button>
</form>

<button class="ne-stampaj" type="button" onclick="window.print()">Štampaj evidenciju</button>

