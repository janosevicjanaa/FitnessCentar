@model PrezentacioniSloj.ViewModels.EvidencijaVezbiViewModel

<style>
	@@media print{
		.ne-stampaj{
			display: none;
		}
	}

</style>

<div class="upravljanje-clanarinom">
	<div class="naslov">
		<h2>EVIDENCIJA VEŽBI</h2>

		<form asp-controller="Korisnik" asp-action="Index" method="get">
			<button class="dugme-prvo ne-stampaj" type="submit">Nazad</button>
		</form>
	</div>
	

	@{
		var datum = Model.Datum.ToString("dddd, d. MMMM, yyyy", new System.Globalization.CultureInfo("sr-Latn-RS"));
		datum = char.ToUpper(datum[0]) + datum.Substring(1);
	}

	<p class="datum">@datum</p>


	<table class="tabela">
		<thead>
			<tr>
				<th>Naziv vežbe</th>
				<th>Tip</th>
				<th>Br. Serija</th>
				<th>Br. Ponavljanja</th>
				<th>Težina</th>
				<th>Trajanje</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var vezba in Model.Vezbe)
			{

				<tr>
					<td>@vezba.NazivVezbe</td>
					<td>@vezba.NazivTipa</td>
					<td>@vezba.BrojSerija</td>
					<td>@vezba.BrojPonavljanja</td>
					<td>@vezba.Tezina</td>
					<td class="prikazi-pozadinu">@vezba.Trajanje</td>
				</tr>

			}
		</tbody>
	</table>

	<form asp-action="IzmeniEvidenciju" method="get">
		<input type="hidden" name="datum" value="@Model.Datum.ToString("yyyy-MM-dd")" />
		<button class="ne-stampaj dugme-prvo evidencija" type="submit">Izmeni evidenciju</button>
	</form>

	<button class="ne-stampaj dugme-drugo evidencija" type="button" onclick="window.print()">Štampaj evidenciju</button>

	<form asp-action="IzbrisiSve" method="post">
		<input type="hidden" name="datum" value="@Model.Datum" />
		<button class="ne-stampaj dugme-trece evidencija" type="submit">Izbriši evidenciju</button>
	</form>

	
</div>


