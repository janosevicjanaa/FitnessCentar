@model PrezentacioniSloj.ViewModels.NovaEvidencijaViewModel
<div class="upravljanje-clanarinom">
    <div class="naslov">
        <h2>NOVA EVIDENCIJA</h2>

        <form asp-controller="Korisnik" asp-action="Index" method="get">
            <button class="dugme-prvo" type="submit">Nazad</button>
        </form>
    </div>
    
    @if (TempData["PorukaRealizacija"] != null)
    {
        <div>
            @TempData["PorukaRealizacija"]
        </div>
    }

    @{
        var datum = Model.Datum.ToString(
        "dddd, d. MMMM, yyyy",
        new System.Globalization.CultureInfo("sr-Latn-RS"));

        datum = char.ToUpper(datum[0]) + datum.Substring(1);
    }
    <div class="datum">
        <p>@datum</p>
    </div>
    

    @if (Model.DanasnjeVezbe.Count > 0)
    {
        <table class="tabela">
            <thead>
                <tr>
                    <th>Naziv Vežbe</th>
                    <th>Tip</th>
                    <th>Br. Serija</th>
                    <th>Br. Ponavljanja</th>
                    <th>Težina</th>
                    <th>Trajanje</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var vezba in Model.DanasnjeVezbe)
                {
                    <tr>
                        <td>@vezba.NazivVezbe</td>
                        <td>@vezba.NazivTipa</td>
                        <td>@vezba.BrojSerija</td>
                        <td>@vezba.BrojPonavljanja</td>
                        <td>@vezba.Tezina</td>
                        <td>@vezba.Trajanje</td>
                        <td class="tabela-dugmad">
                            <form asp-action="IzmeniVezbu" method="get">
                                <input type="hidden" name="realizacijaID" value="@vezba.RealizacijaID" />
                                <button class="dugme-prvo izmeni" type="submit">Izmeni</button>
                            </form>

                            <form asp-controller="Korisnik" asp-action="IzbrisiVezbu" method="post">
                                <input type="hidden" name="realizacijaID" value="@vezba.RealizacijaID" />
                                <button class="dugme-trece" type="submit">Izbriši</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <div class="evidencija-forma">
        <form asp-action="SacuvajVezbu" method="post" onsubmit="return proveriFormu()">

            <input type="hidden" asp-for="Datum" />
            <input type="hidden" asp-for="NovaVezba.RealizacijaID" />

            <div class="evidencija-forma-gornja">
                <div class="forma-polje naziv">
                    <label>Naziv vežbe</label>
                    <input asp-for="NovaVezba.NazivVezbe" />
                </div>
                
                <div class="forma-polje tip">
                    <label>Tip</label>

                    <select asp-for="NovaVezba.TipVezbeID">

                        <option value="">
                            Izaberite tip
                        </option>

                        @foreach (var tip in Model.TipoviVezbe)
                        {
                            <option value="@tip.TipVezbeID">
                                @tip.NazivTipa
                            </option>
                        }

                    </select>
                </div>
                
            </div>

            <div class="evidencija-forma-donja">
                <div class="forma-polje manje">
                    <label>Br. Serija</label>
                    <input asp-for="NovaVezba.BrojSerija" />
                </div>
                
                <div class="forma-polje manje">
                    <label>Br. Ponavljanja</label>
                    <input asp-for="NovaVezba.BrojPonavljanja" />
                </div>
                
                <div class="forma-polje manje">
                    <label>Težina(kg)</label>
                    <input asp-for="NovaVezba.Tezina" />
                </div>
                
                <div class="forma-polje manje">
                    <label>Trajanje(min)</label>
                    <input asp-for="NovaVezba.Trajanje" />
                </div>
               
            </div>



            <button class="dugme-prvo" type="submit">
                Sačuvaj vežbu
            </button>

        </form>
    </div>
   

    <form asp-action="SacuvajSve" method="post">
        <button class="dugme-drugo evidencija" type="submit">Sačuvaj sve</button>
    </form>


    <form asp-action="IzbrisiSve" method="post" onsubmit="return confirm('Da li ste sigurni da želite da izbrišete sve unete vežbe?');">

        <input type="hidden" name="datum" value="@Model.Datum.ToString("yyyy-MM-dd")" />

        <input type="hidden" name="povratak" value="NovaEvidencija" />

        <button class="dugme-trece evidencija" type="submit">Izbriši sve</button>

    </form>
</div>


<script>
    function proveriFormu() {
        var naziv = document.getElementById("NovaVezba_NazivVezbe").value;
        var tip = document.getElementById("NovaVezba_TipVezbeID").value;

        if(naziv.trim() === ""){
            alert("Unesite naziv vežbe!");
            return false;
        }

        if(tip === "" || tip === "0"){
            alert("Izaberite tip vežbe!");
            return false;
        }

        return true;
    }
</script>