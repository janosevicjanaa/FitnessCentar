@model PrezentacioniSloj.ViewModels.PrijavaViewModel


    <div class="prijava">
        <h2>PRIJAVITE SE</h2>
        <div class="prijava-forma">
            <form asp-action="Index" method="post">

                <div asp-validation-summary="ModelOnly"></div>

                <div class="forma-polje">
                    <label>Email</label>
                    <input asp-for="Email" />
                    <span asp-validation-for="Email"></span>
                </div>

                

                <div class="forma-polje">
                    <label>Lozinka</label>
                    <input asp-for="Lozinka" type="password" />
                    <span asp-validation-for="Lozinka"></span>
                </div>

                

                <button class="dugme-prvo" type="submit">Prijavi se</button>

            </form>
        </div>
        

        <p>Nemate nalog? <a asp-controller="Registracija" asp-action="Index">Kreiraj nalog</a></p>
    </div>
   




@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}