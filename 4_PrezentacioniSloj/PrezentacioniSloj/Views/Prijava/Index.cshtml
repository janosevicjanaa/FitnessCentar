@model PrezentacioniSloj.ViewModels.PrijavaViewModel

<h2>Prijava korisnika</h2>

<form asp-action="Index" method="post">

    <div>
        <label>Email:</label>
        <input asp-for="Email" />
        <span asp-validation-for="Email"></span>
    </div>

    <br />

    <div>
        <label>Lozinka:</label>
        <input asp-for="Lozinka" type="password" />
        <span asp-validation-for="Lozinka"></span>
    </div>

    <br />

    <button type="submit">Prijavi se</button>

</form>

<p>Nemate nalog? <a asp-controller="Registracija" asp-action="Index">Kreiraj nalog</a></p>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}